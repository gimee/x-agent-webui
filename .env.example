# Host publishing only: the container always listens on port 6060.
X_AGENT_BIND=127.0.0.1
X_AGENT_PORT=6060

# Keep this stable: it is the prefix of the four named data volumes.
# The curl installer generates a directory-specific name instead.
COMPOSE_PROJECT_NAME=x-agent-webui

# Do not put model keys here. Configure providers after login in X-Agent-Webui.
